<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sdk_demo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_32">

        <!-- 页面顶部 Header：大标题、副标题与旧版跳转链接 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tv_btn_legacy_nav"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_demo_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/standalone_demo_title"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="@dimen/sp_22"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_demo_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/standalone_demo_subtitle"
                    android:textColor="@color/demo_text_secondary"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_btn_legacy_nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/dp_8"
                android:text="@string/standalone_btn_legacy_nav"
                android:textColor="@color/demo_status_info"
                android:textSize="@dimen/sp_13" />
        </RelativeLayout>

        <!-- 卡片 1：SDK 运行状态看板 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            app:cardBackgroundColor="@color/demo_surface"
            app:cardCornerRadius="@dimen/dp_16"
            app:cardElevation="0dp"
            app:strokeColor="@color/demo_button_secondary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="@string/standalone_status_title"
                        android:textColor="@color/demo_text_primary"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_toggle_sdk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:checked="true"
                        app:useMaterialThemeColors="true" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tv_sdk_status_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@string/standalone_status_active"
                    android:textColor="@color/demo_status_success"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/standalone_status_details"
                    android:textColor="@color/demo_text_hint"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片 2：打开调试中枢快捷按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_showlog_console"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/standalone_btn_open_console"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold"
            app:backgroundTint="@color/demo_button_primary"
            app:cornerRadius="@dimen/dp_12" />

        <!-- 卡片 2.5：三大同级类目直达栏（并列排布） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_direct_network"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_48"
                android:layout_weight="1"
                android:text="🌐 网络"
                android:textColor="@color/demo_text_primary"
                android:textSize="@dimen/sp_12"
                app:cornerRadius="@dimen/dp_8"
                app:strokeColor="@color/demo_button_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_direct_device"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_48"
                android:layout_marginStart="@dimen/dp_6"
                android:layout_weight="1"
                android:text="📱 设备"
                android:textColor="@color/demo_text_primary"
                android:textSize="@dimen/sp_12"
                app:cornerRadius="@dimen/dp_8"
                app:strokeColor="@color/demo_button_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_direct_custom"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_48"
                android:layout_marginStart="@dimen/dp_6"
                android:layout_weight="1"
                android:text="🧩 扩展"
                android:textColor="@color/demo_text_primary"
                android:textSize="@dimen/sp_12"
                app:cornerRadius="@dimen/dp_8"
                app:strokeColor="@color/demo_button_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_file_browser_demo_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:textColor="@color/demo_text_hint"
            android:textSize="@dimen/sp_12"
            android:text="@string/file_browser_demo_path" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_direct_file_browser"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/standalone_btn_nav_file_browser"
            android:textColor="@color/demo_text_primary"
            android:textSize="@dimen/sp_13"
            app:cornerRadius="@dimen/dp_8"
            app:strokeColor="@color/demo_button_secondary" />

        <!-- 卡片 3：真实网络请求测试区 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            app:cardBackgroundColor="@color/demo_surface"
            app:cardCornerRadius="@dimen/dp_16"
            app:cardElevation="0dp"
            app:strokeColor="@color/demo_button_secondary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/standalone_actions_title"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <!-- 按钮 1：GET 请求 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_get"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/standalone_btn_get"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_13"
                    app:backgroundTint="@color/demo_button_secondary"
                    app:cornerRadius="@dimen/dp_8" />

                <!-- 按钮 2：POST JSON 请求 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_post"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/standalone_btn_post"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_13"
                    app:backgroundTint="@color/demo_button_secondary"
                    app:cornerRadius="@dimen/dp_8" />

                <!-- 按钮 3：404 错误请求 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_404"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/standalone_btn_404"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_13"
                    app:backgroundTint="@color/demo_status_warning"
                    app:cornerRadius="@dimen/dp_8" />

                <!-- 按钮 4：网络断开异常请求 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_network_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/standalone_btn_network_error"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_13"
                    app:backgroundTint="@color/demo_status_danger"
                    app:cornerRadius="@dimen/dp_8" />

                <!-- 按钮 5：纯抽象契约上报成功 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_custom_payload_success"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/standalone_btn_custom_payload_success"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_13"
                    app:backgroundTint="@color/demo_status_success"
                    app:cornerRadius="@dimen/dp_8" />

                <!-- 按钮 6：纯抽象契约上报业务失败 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_custom_payload_failed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/standalone_btn_custom_payload_failed"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_13"
                    app:backgroundTint="@color/demo_status_warning"
                    app:cornerRadius="@dimen/dp_8" />

                <!-- 按钮 7：清空网络日志 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_all_logs"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/standalone_btn_clear_logs"
                    android:textColor="@color/demo_text_secondary"
                    android:textSize="@dimen/sp_13"
                    app:cornerRadius="@dimen/dp_8"
                    app:strokeColor="@color/demo_button_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片 4：即时响应反馈区 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:cardBackgroundColor="@color/demo_surface"
            app:cardCornerRadius="@dimen/dp_16"
            app:cardElevation="0dp"
            app:strokeColor="@color/demo_button_secondary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/standalone_result_title"
                    android:textColor="@color/demo_text_primary"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_request_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:background="@drawable/bg_status_chip"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:padding="@dimen/dp_12"
                    android:text="@string/standalone_result_idle"
                    android:textColor="@color/demo_text_secondary"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

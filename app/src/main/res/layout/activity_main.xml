<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/network_test_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_24"
        tools:context=".MainActivity">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/network_test_page_title"
            android:textColor="@color/demo_text_primary"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/network_test_page_subtitle"
            android:textColor="@color/demo_text_secondary"
            android:textSize="@dimen/sp_13" />

        <TextView
            android:id="@+id/tv_vpn_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:textColor="@color/demo_text_secondary"
            android:textSize="@dimen/sp_13" />

        <Button
            android:id="@+id/btn_open_console"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/dp_24"
            android:backgroundTint="@color/demo_button_primary"
            android:text="@string/app_demo_btn_open_console"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15" />

        <Button
            android:id="@+id/btn_check_status"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/dp_16"
            android:backgroundTint="@color/demo_button_secondary"
            android:text="@string/app_demo_btn_toggle_debug"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15" />

        <Button
            android:id="@+id/btn_test_get"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/dp_16"
            android:backgroundTint="@color/demo_status_success"
            android:text="@string/test_http_get"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15" />

        <Button
            android:id="@+id/btn_test_post"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/dp_12"
            android:backgroundTint="@color/demo_status_info"
            android:text="@string/test_https_post"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15" />

        <Button
            android:id="@+id/btn_test_error"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/dp_12"
            android:backgroundTint="@color/demo_status_danger"
            android:text="@string/test_http_error"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15" />

        <Button
            android:id="@+id/btn_okhttp_weather"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/dp_12"
            android:backgroundTint="@color/demo_status_warning"
            android:text="@string/test_okhttp_weather_get"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15" />

        <Button
            android:id="@+id/btn_okhttp_form"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/dp_12"
            android:backgroundTint="@color/demo_surface_alt"
            android:text="@string/test_okhttp_form_post"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15" />

        <Button
            android:id="@+id/btn_okhttp_json"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/dp_12"
            android:backgroundTint="@color/demo_status_neutral"
            android:text="@string/test_okhttp_json_post"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15" />

    </LinearLayout>
</ScrollView>

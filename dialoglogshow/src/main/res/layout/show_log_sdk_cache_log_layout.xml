<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="24dp"
    android:background="@drawable/show_sdk_dialog_bg"
    android:elevation="24dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header / Title Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/show_app_dialog_cache_file_log_tv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/show_sdk_btn_dark_bg"
            android:drawableStart="@drawable/baseline_drive_file_move_rtl_24_file_back"
            android:drawablePadding="6dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/show_sdk_back"
            android:textColor="#06B6D4"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/show_app_dialog_cache_file_log_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_toEndOf="@id/show_app_dialog_cache_file_log_tv_back"
            android:layout_toStartOf="@+id/show_app_dialog_confirm_btnok"
            android:ellipsize="middle"
            android:gravity="center"
            android:lines="1"
            android:singleLine="true"
            android:textColor="#F8FAFC"
            android:textSize="14dp"
            android:textStyle="bold"
            tools:text="/storage/emulated/0/cache/log..." />

        <TextView
            android:id="@+id/show_app_dialog_confirm_btnok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/show_sdk_btn_close_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/show_sdk_close"
            android:textColor="#FFFFFF"
            android:textSize="12dp" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/show_app_dialog_cache_file_log_review"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:background="@drawable/show_sdk_content_bg"
        android:padding="8dp"
        android:scrollbars="vertical" />

    <!-- 底部控制区域：提供更适合单手操作的底部关闭按钮 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/show_app_dialog_confirm_btnok_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/show_sdk_btn_close_bg"
            android:paddingVertical="10dp"
            android:text="@string/show_sdk_close"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

</LinearLayout>
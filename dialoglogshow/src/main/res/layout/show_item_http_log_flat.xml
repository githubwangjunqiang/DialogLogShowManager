<?xml version="1.0" encoding="utf-8"?>
<!--
  为什么这样做：列表项只需要让用户快速判断“哪个接口、什么时候、成功还是失败”，
  因此第一行放结果徽标、请求方式与时间，第二行放完整接口地址；
  接口地址不限制行数，超出一行自动换行，保证长 URL 也能完整辨认；
  卡片背景改为水波纹，保证点击进入详情时有明确按压反馈。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_6"
    android:background="@drawable/bg_showlog_card_ripple"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_10"
    android:paddingTop="@dimen/dp_8"
    android:paddingEnd="@dimen/dp_10"
    android:paddingBottom="@dimen/dp_8">

    <!-- 第一行：业务成功/失败徽标 + 请求方式 + 时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_success"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_showlog_pill"
            android:paddingStart="@dimen/dp_6"
            android:paddingTop="@dimen/dp_2"
            android:paddingEnd="@dimen/dp_6"
            android:paddingBottom="@dimen/dp_2"
            android:textColor="@color/showlog_status_2xx"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold"
            tools:text="成功" />

        <TextView
            android:id="@+id/tv_method"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"
            android:textColor="@color/showlog_text_method"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            tools:text="POST" />

        <TextView
            android:id="@+id/tv_timestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/showlog_text_tertiary"
            android:textSize="@dimen/sp_11"
            tools:text="14:20:05.123" />
    </LinearLayout>

    <!-- 第二行：接口全名，不限制行数，超出一行自动换行，长 URL 不会被截断 -->
    <TextView
        android:id="@+id/tv_full_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:textColor="@color/showlog_text_primary"
        android:textSize="@dimen/sp_12"
        tools:text="https://api.example.com/api/v1/user/login?redirect=%2Fdashboard%3Ftab%3Dorders" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_showlog_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_20"
    android:paddingTop="@dimen/dp_20"
    android:paddingEnd="@dimen/dp_20"
    android:paddingBottom="@dimen/dp_16">

    <!-- 弹窗标题 -->
    <TextView
        android:id="@+id/tv_dialog_clear_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/showlog_clear_dialog_title"
        android:textColor="@color/showlog_text_primary"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold" />

    <!-- 说明文案 -->
    <TextView
        android:id="@+id/tv_dialog_clear_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/showlog_clear_dialog_msg"
        android:textColor="@color/showlog_text_secondary"
        android:textSize="@dimen/sp_13" />

    <!-- 选项 1：仅清理当前选中日期（浅蓝安全操作） -->
    <TextView
        android:id="@+id/btn_clear_option_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@drawable/bg_showlog_tab_unselected"
        android:gravity="center"
        android:padding="@dimen/dp_12"
        android:text="📅 仅清理当前选中日期"
        android:textColor="@color/showlog_action_btn"
        android:textSize="@dimen/sp_13"
        android:textStyle="bold" />

    <!-- 选项 2：清空全部历史网络日志（警示红色操作） -->
    <TextView
        android:id="@+id/btn_clear_option_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:background="@drawable/bg_showlog_tab_unselected"
        android:gravity="center"
        android:padding="@dimen/dp_12"
        android:text="⚠️ 清空全部历史网络日志 (所有日期)"
        android:textColor="@color/showlog_status_error"
        android:textSize="@dimen/sp_13"
        android:textStyle="bold" />

    <!-- 取消按钮 -->
    <TextView
        android:id="@+id/btn_clear_option_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:padding="@dimen/dp_10"
        android:text="@string/showlog_cancel"
        android:textColor="@color/showlog_text_tertiary"
        android:textSize="@dimen/sp_13" />
</LinearLayout>

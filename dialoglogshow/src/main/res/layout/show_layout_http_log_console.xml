<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. 顶部操作栏：日期快速切换、总数统计、清理按钮 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/dp_6">

        <!-- 左侧：日期前一天/当前日期(日历挑选)/后一天 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_date_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_showlog_pill"
                android:paddingStart="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_4"
                android:text="@string/showlog_prev_day"
                android:textColor="@color/showlog_text_secondary"
                android:textSize="@dimen/sp_11" />

            <TextView
                android:id="@+id/tv_current_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_6"
                android:layout_marginEnd="@dimen/dp_6"
                android:background="@drawable/bg_showlog_pill"
                android:paddingStart="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_4"
                android:text="📅 2026-10-19 ▾"
                android:textColor="@color/showlog_action_btn"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_date_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_showlog_pill"
                android:paddingStart="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_4"
                android:text="@string/showlog_next_day"
                android:textColor="@color/showlog_text_secondary"
                android:textSize="@dimen/sp_11" />
        </LinearLayout>

        <!-- 右侧：统计徽标与清理按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_total_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_8"
                android:background="@drawable/bg_showlog_pill"
                android:paddingStart="@dimen/dp_6"
                android:paddingTop="@dimen/dp_2"
                android:paddingEnd="@dimen/dp_6"
                android:paddingBottom="@dimen/dp_2"
                android:text="0条"
                android:textColor="@color/showlog_text_secondary"
                android:textSize="@dimen/sp_11" />

            <TextView
                android:id="@+id/btn_action_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_showlog_pill"
                android:gravity="center"
                android:paddingStart="@dimen/dp_10"
                android:paddingTop="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_4"
                android:text="🗑️ 清理"
                android:textColor="@color/showlog_status_5xx"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. 二级控制栏：胶囊分段视图选择器 + 时间正倒序切换按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 扁平列表 / 接口分组 分段选择器 -->
        <LinearLayout
            android:id="@+id/layout_view_mode_segmented"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_32"
            android:background="@drawable/bg_showlog_segmented_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/dp_2">

            <TextView
                android:id="@+id/btn_seg_flat"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_showlog_tab_selected"
                android:gravity="center"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:text="@string/showlog_view_flat_short"
                android:textColor="#FF0F172A"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_seg_group"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_showlog_tab_unselected"
                android:gravity="center"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:text="@string/showlog_view_group_short"
                android:textColor="@color/showlog_text_secondary"
                android:textSize="@dimen/sp_11" />
        </LinearLayout>

        <!-- 弹性间距 -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 时间正序/倒序指示切换按钮 -->
        <TextView
            android:id="@+id/btn_toggle_sort"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_32"
            android:background="@drawable/bg_showlog_pill"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_10"
            android:text="@string/showlog_sort_desc_label"
            android:textColor="@color/showlog_text_primary"
            android:textSize="@dimen/sp_11" />
    </LinearLayout>

    <!-- 3. 搜索框 -->
    <EditText
        android:id="@+id/et_search_filter"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/bg_showlog_search"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="@dimen/dp_8"
        android:hint="@string/showlog_search_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        android:textColor="@color/showlog_text_primary"
        android:textColorHint="@color/showlog_text_secondary"
        android:textSize="@dimen/sp_12" />

    <!-- 4. 彩色状态分类 Tab 栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_filter_all"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_30"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_selected"
            android:gravity="center"
            android:text="全部 (0)"
            android:textColor="#FF0F172A"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_filter_2xx"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_unselected"
            android:gravity="center"
            android:text="2xx 成功 (0)"
            android:textColor="@color/showlog_status_2xx"
            android:textSize="@dimen/sp_11" />

        <TextView
            android:id="@+id/tab_filter_error"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_unselected"
            android:gravity="center"
            android:text="错误/异常 (0)"
            android:textColor="@color/showlog_status_5xx"
            android:textSize="@dimen/sp_11" />
    </LinearLayout>

    <!-- 5. 核心内容区域：RecyclerView + 空数据与加载态提示 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_http_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/dp_16"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableTop="@android:drawable/ic_menu_info_details"
            android:drawablePadding="@dimen/dp_8"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/dp_4"
            android:text="@string/showlog_empty_tip"
            android:textColor="@color/showlog_text_secondary"
            android:textSize="@dimen/sp_13"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

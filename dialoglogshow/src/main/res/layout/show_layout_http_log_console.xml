<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. 顶部操作栏：日期切换 + 搜索入口 + 清理；不再显示与列表重复的条数徽标 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/dp_6">

        <!-- 左侧：前一天三角 / 日期 / 后一天三角 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_date_prev"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/showlog_prev_day"
                android:scaleType="centerInside"
                android:src="@drawable/ic_showlog_triangle_left" />

            <TextView
                android:id="@+id/tv_current_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_2"
                android:layout_marginEnd="@dimen/dp_2"
                android:layout_weight="1"
                android:background="@drawable/bg_showlog_pill"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_4"
                android:textColor="@color/showlog_action_btn"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_date_next"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/showlog_next_day"
                android:scaleType="centerInside"
                android:src="@drawable/ic_showlog_triangle_right" />
        </LinearLayout>

        <!-- 右侧：搜索入口 + 清理 -->
        <ImageView
            android:id="@+id/btn_search"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginStart="@dimen/dp_4"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/showlog_search"
            android:scaleType="centerInside"
            android:src="@drawable/ic_showlog_search" />

        <TextView
            android:id="@+id/btn_action_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_4"
            android:background="@drawable/bg_showlog_pill"
            android:gravity="center"
            android:paddingStart="@dimen/dp_10"
            android:paddingTop="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_4"
            android:text="@string/showlog_clear_logs"
            android:textColor="@color/showlog_status_5xx"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. 视图模式与时间排序：各自收敛为单个左右滑动开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.xq.dialoglogshow.ui.view.ShowLogToggleSwitch
            android:id="@+id/btn_view_mode_switch"
            android:layout_width="@dimen/dp_132"
            android:layout_height="@dimen/dp_32"
            android:background="@drawable/bg_showlog_toggle_track"
            android:padding="@dimen/dp_2" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.xq.dialoglogshow.ui.view.ShowLogToggleSwitch
            android:id="@+id/btn_sort_switch"
            android:layout_width="@dimen/dp_112"
            android:layout_height="@dimen/dp_32"
            android:background="@drawable/bg_showlog_toggle_track"
            android:padding="@dimen/dp_2" />
    </LinearLayout>

    <!-- 3. 当前搜索关键字：仅在有搜索条件时显示，点击可重新编辑；
         使用 wrap_content 保持胶囊形态，避免看起来又变回一个常驻搜索输入框 -->
    <TextView
        android:id="@+id/tv_search_keyword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:background="@drawable/bg_showlog_pill"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:maxLines="1"
        android:paddingStart="@dimen/dp_8"
        android:paddingTop="@dimen/dp_4"
        android:paddingEnd="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_4"
        android:textColor="@color/showlog_action_btn"
        android:textSize="@dimen/sp_11"
        android:visibility="gone" />

    <!-- 4. 彩色状态分类 Tab 栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_filter_all"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_30"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_selected"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/showlog_text_on_accent"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_filter_2xx"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_unselected"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/showlog_status_2xx"
            android:textSize="@dimen/sp_11" />

        <TextView
            android:id="@+id/tab_filter_error"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_unselected"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/showlog_status_5xx"
            android:textSize="@dimen/sp_11" />
    </LinearLayout>

    <!-- 5. 核心内容区域：RecyclerView + 空数据与加载态提示 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_http_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/dp_16"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableTop="@android:drawable/ic_menu_info_details"
            android:drawablePadding="@dimen/dp_8"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/dp_4"
            android:text="@string/showlog_empty_tip"
            android:textColor="@color/showlog_text_secondary"
            android:textSize="@dimen/sp_13"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

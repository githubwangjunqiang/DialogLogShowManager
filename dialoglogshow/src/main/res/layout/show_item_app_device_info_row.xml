<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_6"
    android:background="@drawable/bg_showlog_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/dp_12"
    android:paddingTop="@dimen/dp_10"
    android:paddingEnd="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_10">

    <!-- 左侧：属性名称与分类指示 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_info_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="应用包名"
            android:textColor="@color/showlog_text_primary"
            android:textSize="@dimen/sp_13"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_info_category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="应用画像"
            android:textColor="@color/showlog_text_tertiary"
            android:textSize="@dimen/sp_11" />
    </LinearLayout>

    <!-- 右侧：属性数值（等宽科技字体，高对比度）与长按提示 -->
    <TextView
        android:id="@+id/tv_info_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:fontFamily="monospace"
        android:gravity="end"
        android:maxLines="4"
        android:text="com.example.app"
        android:textColor="@color/showlog_action_btn"
        android:textSize="@dimen/sp_12" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_showlog_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_12"
    android:paddingTop="@dimen/dp_12"
    android:paddingEnd="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_8">

    <!-- 1. 顶部操作栏：标题 + 快捷操作（刷新、导出报告、关闭） -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_device_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 应用与设备全景"
                android:textColor="@color/showlog_text_primary"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_info_items_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:background="@drawable/bg_showlog_pill"
                android:paddingStart="@dimen/dp_6"
                android:paddingTop="@dimen/dp_2"
                android:paddingEnd="@dimen/dp_6"
                android:paddingBottom="@dimen/dp_2"
                android:text="0项"
                android:textColor="@color/showlog_text_secondary"
                android:textSize="@dimen/sp_11" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 刷新实时性能与电量状态 -->
            <TextView
                android:id="@+id/btn_refresh_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_showlog_pill"
                android:gravity="center"
                android:paddingStart="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_4"
                android:text="🔄 刷新"
                android:textColor="@color/showlog_text_secondary"
                android:textSize="@dimen/sp_11" />

            <!-- 一键导出 Markdown 诊断报告 -->
            <TextView
                android:id="@+id/btn_export_markdown_report"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:background="@drawable/bg_showlog_pill"
                android:gravity="center"
                android:paddingStart="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_4"
                android:text="📋 导出报告"
                android:textColor="@color/showlog_action_btn"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold" />

            <!-- 关闭按钮 -->
            <ImageView
                android:id="@+id/btn_close_device_info"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_10"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/dp_2"
                android:src="@drawable/ic_showlog_close" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. 分类过滤胶囊组（全部、应用、系统、硬件、性能） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_category_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_6"
                android:background="@drawable/bg_showlog_tab_selected"
                android:paddingStart="@dimen/dp_12"
                android:paddingTop="@dimen/dp_6"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_6"
                android:text="全部"
                android:textColor="#FF0F172A"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_category_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_6"
                android:background="@drawable/bg_showlog_tab_unselected"
                android:paddingStart="@dimen/dp_12"
                android:paddingTop="@dimen/dp_6"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_6"
                android:text="📦 应用"
                android:textColor="@color/showlog_text_secondary"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/tab_category_os"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_6"
                android:background="@drawable/bg_showlog_tab_unselected"
                android:paddingStart="@dimen/dp_12"
                android:paddingTop="@dimen/dp_6"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_6"
                android:text="🤖 系统"
                android:textColor="@color/showlog_text_secondary"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/tab_category_hardware"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_6"
                android:background="@drawable/bg_showlog_tab_unselected"
                android:paddingStart="@dimen/dp_12"
                android:paddingTop="@dimen/dp_6"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_6"
                android:text="💻 硬件"
                android:textColor="@color/showlog_text_secondary"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/tab_category_performance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_showlog_tab_unselected"
                android:paddingStart="@dimen/dp_12"
                android:paddingTop="@dimen/dp_6"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_6"
                android:text="⚡ 性能"
                android:textColor="@color/showlog_text_secondary"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. 实时关键词过滤搜索框 -->
    <EditText
        android:id="@+id/et_search_device_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/bg_showlog_search"
        android:hint="搜索属性名称或数值 (如: sha / 64 / 内存 / dpi)"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:paddingStart="@dimen/dp_10"
        android:paddingTop="@dimen/dp_6"
        android:paddingEnd="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_6"
        android:singleLine="true"
        android:textColor="@color/showlog_text_primary"
        android:textColorHint="@color/showlog_text_tertiary"
        android:textSize="@dimen/sp_12" />

    <!-- 4. 信息数据列表呈现区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_device_info_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tv_device_info_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="未找到匹配的属性条目"
            android:textColor="@color/showlog_text_tertiary"
            android:textSize="@dimen/sp_13"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

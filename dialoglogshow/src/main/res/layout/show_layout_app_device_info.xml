<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. 顶部操作栏：数据项数统计 + 刷新按钮 + 导出报告按钮 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/dp_6">

        <TextView
            android:id="@+id/tv_info_items_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_showlog_pill"
            android:paddingStart="@dimen/dp_8"
            android:paddingTop="@dimen/dp_2"
            android:paddingEnd="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_2"
            android:text="0项"
            android:textColor="@color/showlog_text_secondary"
            android:textSize="@dimen/sp_11" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_refresh_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_8"
                android:background="@drawable/bg_showlog_pill"
                android:gravity="center"
                android:paddingStart="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_4"
                android:text="🔄 刷新"
                android:textColor="@color/showlog_action_btn"
                android:textSize="@dimen/sp_11" />

            <TextView
                android:id="@+id/btn_export_markdown_report"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_showlog_pill"
                android:gravity="center"
                android:paddingStart="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_4"
                android:text="📋 导出报告"
                android:textColor="@color/showlog_text_primary"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. 分类筛选 Tab 栏（全部、应用、系统、硬件、性能） -->
    <LinearLayout
        android:id="@+id/layout_category_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_category_all"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_30"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_selected"
            android:gravity="center"
            android:text="全部"
            android:textColor="#FF0F172A"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_category_app"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_unselected"
            android:gravity="center"
            android:text="📦 应用"
            android:textColor="@color/showlog_text_secondary"
            android:textSize="@dimen/sp_11" />

        <TextView
            android:id="@+id/tab_category_os"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_unselected"
            android:gravity="center"
            android:text="🤖 系统"
            android:textColor="@color/showlog_text_secondary"
            android:textSize="@dimen/sp_11" />

        <TextView
            android:id="@+id/tab_category_hardware"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_unselected"
            android:gravity="center"
            android:text="💻 硬件"
            android:textColor="@color/showlog_text_secondary"
            android:textSize="@dimen/sp_11" />

        <TextView
            android:id="@+id/tab_category_performance"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_unselected"
            android:gravity="center"
            android:text="⚡ 性能"
            android:textColor="@color/showlog_text_secondary"
            android:textSize="@dimen/sp_11" />
    </LinearLayout>

    <!-- 3. 搜索过滤框 -->
    <EditText
        android:id="@+id/et_search_device_info"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/bg_showlog_search"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="@dimen/dp_8"
        android:hint="搜索属性名称或数值 (如: sha / 64 / 内存 / dpi)"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        android:textColor="@color/showlog_text_primary"
        android:textColorHint="@color/showlog_text_secondary"
        android:textSize="@dimen/sp_12" />

    <!-- 4. 属性列表 RecyclerView 与 空视图 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_device_info_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/dp_16"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tv_device_info_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableTop="@android:drawable/ic_menu_info_details"
            android:drawablePadding="@dimen/dp_8"
            android:gravity="center"
            android:text="没有匹配的系统或设备属性"
            android:textColor="@color/showlog_text_secondary"
            android:textSize="@dimen/sp_13"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

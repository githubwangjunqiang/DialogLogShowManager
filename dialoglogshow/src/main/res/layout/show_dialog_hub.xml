<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_showlog_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_12"
    android:paddingTop="@dimen/dp_12"
    android:paddingEnd="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_8">

    <!-- 1. 顶栏：调试中枢总标题 + 关闭按钮 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_8"
                android:background="@drawable/bg_showlog_tab_selected" />

            <TextView
                android:id="@+id/tv_hub_main_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:text="@string/showlog_hub_title"
                android:textColor="@color/showlog_text_primary"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_hub"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/show_sdk_close"
            android:padding="@dimen/dp_6"
            android:src="@drawable/ic_showlog_close" />
    </RelativeLayout>

    <!-- 2. 顶级同级胶囊分段导航栏 (网络日志 / 设备信息 / 自定义扩展) -->
    <LinearLayout
        android:id="@+id/layout_hub_segmented_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_10"
        android:background="@drawable/bg_showlog_segmented_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/dp_2">

        <TextView
            android:id="@+id/tab_hub_network"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_selected"
            android:gravity="center"
            android:text="@string/showlog_hub_tab_network"
            android:textColor="#FF0F172A"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_hub_device"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_unselected"
            android:gravity="center"
            android:text="@string/showlog_hub_tab_device"
            android:textColor="@color/showlog_text_secondary"
            android:textSize="@dimen/sp_12" />

        <TextView
            android:id="@+id/tab_hub_custom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_weight="1"
            android:background="@drawable/bg_showlog_tab_unselected"
            android:gravity="center"
            android:text="@string/showlog_hub_tab_custom"
            android:textColor="@color/showlog_text_secondary"
            android:textSize="@dimen/sp_12" />
    </LinearLayout>

    <!-- 分隔细线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dp_8"
        android:background="#33334155" />

    <!-- 3. 主视口：ViewPager2 支持手势左右平滑滑动与瞬切 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_hub_pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_weight="1" />
</LinearLayout>

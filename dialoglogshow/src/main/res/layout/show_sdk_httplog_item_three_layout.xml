<?xml version="1.0" encoding="utf-8"?>
<com.xq.dialoglogshow.view.MyTouchFragmentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/show_sdk_id_dialog_http_log_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="4dp">

    <!-- 子节点深色镶嵌卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/show_sdk_item_child_bg"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 详细数据大文本组件 -->
        <com.xq.dialoglogshow.view.BigTextView
            android:id="@+id/show_sdk_id_dialog_http_log_tvbig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- 底部精致工具条：包含层次分隔线与底部靠右对齐的删除按钮 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/show_sdk_id_dialog_http_log_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/show_sdk_btn_delete_item_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/show_sdk_delete"
                android:textColor="#F87171"
                android:textSize="11dp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

</com.xq.dialoglogshow.view.MyTouchFragmentLayout>
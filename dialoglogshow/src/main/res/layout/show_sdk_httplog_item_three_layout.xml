<?xml version="1.0" encoding="utf-8"?>
<com.xq.dialoglogshow.view.MyTouchFragmentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/show_sdk_id_dialog_http_log_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="42dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <com.xq.dialoglogshow.view.BigTextView
        android:id="@+id/show_sdk_id_dialog_http_log_tvbig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/show_sdk_id_dialog_http_log_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:background="@drawable/show_sdk_btn_clear_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="Delete"
        android:textColor="#EF4444"
        android:textSize="12dp" />

</com.xq.dialoglogshow.view.MyTouchFragmentLayout>